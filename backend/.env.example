# Copy this file to backend/.env.
# The user, password, and database name must match the root .env file.
DATABASE_URL=postgresql+psycopg://desktrack:change-me@db:5432/desktrack
# development or production. Production turns off /docs and /redoc.
ENVIRONMENT=development
# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# The Clerk variables for token verification arrive in Week 2.
